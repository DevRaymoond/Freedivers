# Multipunk — variáveis de ambiente do servidor. Copie para .env (na pasta do jogo, na VPS) e preencha.
# NUNCA comite o .env: ele já está no .gitignore.

# Neon → Dashboard → seu projeto → Connect → copie a "Pooled connection" (a que tem "-pooler" no host).
# Use sslmode=verify-full no final.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full

# Porta e endereço. Atrás de nginx/Caddy use HOST=127.0.0.1.
PORT=8765
HOST=127.0.0.1

# Atrás de proxy reverso com HTTPS: 1 (usa o IP real do cliente nos limites e marca o cookie como Secure).
TRUST_PROXY=1

# Origens permitidas para POST e WebSocket (vírgula). Vazio = só o mesmo domínio.
ALLOWED_ORIGINS=https://multipunk.com.br

# Opcionais
# BCRYPT_COST=12        (10 a 14)
# SESSION_DAYS=7
# WAR_TICK_MIN=5        (minutos entre os avanços automáticos da guerra)
# MIN_WIN_SECONDS=60    (vitória mais rápida que isso é descartada)
